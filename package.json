{
  "name": "offlinedemo",
  "version": "0.0.1",
  "description": "Demo delivery per scenario offline di una APP Fiori.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {
    "@capacitor/android": "8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/network": "^8.0.1"
  },
  "devDependencies": {
    "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
    "@sap/ux-ui5-tooling": "1",
    "@ui5/cli": "^4.0.33",
    "eslint": "^10"
  },
  "scripts": {
    "start": "fiori run --open \"test/flp.html#app-preview\"",
    "build-local": "ui5 build --config=ui5-local.yaml --clean-dest --dest dist && node scripts/generate-sw-manifest.js",
    "start-local": "node scripts/generate-sw-manifest.js && fiori run --config ./ui5-local.yaml --open \"test/flp.html#app-preview\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "lint": "eslint ./",
    "deploy": "fiori verify",
    "deploy-config": "fiori add deploy-config",
    "start-noflp": "fiori run --open \"/index.html?sap-ui-xx-viewCache=false\"",
    "int-test": "fiori run --open \"test/integration/opaTests.qunit.html\"",
    "start-variants-management": "fiori run --open \"/preview.html#app-preview\"",
    "unit-test": "fiori run --open \"test/unit/unitTests.qunit.html\"",
    "build-webnative": "ui5 build --config=ui5-native.yaml --all --clean-dest --dest dist && node scripts/generate-sw-manifest.js --yaml=ui5-native.yaml",
    "build-webnative-cdn": "ui5 build --config=ui5.yaml --clean-dest --dest dist && node scripts/generate-sw-manifest.js --cdn"
  },
  "sapuxLayer": "CUSTOMER_BASE"
}
